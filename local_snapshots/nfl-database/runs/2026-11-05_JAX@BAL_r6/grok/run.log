    return dict(name=name,team=r.Team,pos=r.Pos,targets=f('Tgt'),completions=f('Cmp'),comp_pct=f('Cmp%'),yds=f('Yds'),ypt=f('Yds/Tgt'),rating=f('Rat'),source=PFR_SRC,pulled_et=T['pfr'])
