           sims=[dict(model=mo,n=SM['meta']['N'],seed=SM['meta']['seed'],script=SIMP,legs={r['name']:dict(p=round(r['ps'][i],4),median=round(r['meds'][i],2)) for r in EM}) for i,mo in enumerate(['monte_carlo','bias','game_randomness'])],
