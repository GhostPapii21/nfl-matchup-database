    for r in E:
        for ph in range(1,16):
            st,num,src,t=r['R'][ph]; ck.append(f"| {clean(r['name'])} | {ph} {PH[ph]} | {st} | {clean(num)} | {clean(src) if st!='N/A' else clean(src or 'n/a')} | {t.replace('T',' ') if t else ''} |")
