language":"en-US","rel":["depthchart","sportscenter","app","team"],"href":"sportscenter://x-callback-url/showClubhouse?uid=s:20~l:28~t:28&section=depthchart","text":"Depth Chart","shortText":"Depth Chart","isExternal":false,"isPremium":false}]},"notes":{"items":[{"id":"645554","type":"news","date":"2026-11-02T04:50Z","headline":"Diggs caught three of six targets for 38 yards and a touchdown in Sunday's 19-10 win over the Eagles.","text":"Diggs scored an eight-yard touchdown in the second quarter, and the ensuing PAT tied the score at 10-10. That was the team-leading fifth receiving touchdown for Diggs in six appearances with the Commanders. He's the top option for Jayden Daniels on paper since Terry McLaurin sustained a season-ending knee injury in Washington's previous game, though Treylon Burks (81) and Antonio Williams (54) both had more receiving yards Sunday, and Williams also drew one more target than Diggs to lead the team. Diggs is poised to maintain a prominent role in Week 9 against the stout Rams secondary.","source":"RotoWire"}]},"status":{"id":"1","name":"Active","type":"active","abbreviation":"Active"}},"source":{"id":"1","description":"basic/manual","state":"basic"},"type":{"id":"0","name":"INJURY_STATUS_ACTIVE","description":"active","abbreviation":"A"}},{"id":"645552","longComment":"Daniels found Stefon Diggs for an eight-yard touchdown in the second quarter and led four drives that ended in successful field goals before Rachaad White sealed the deal with a one-yard touchdown run late in the fourth quarter. Diggs has been on the receiving end of four of Daniels' six touchdown passes this season. Daniels threw for 300 yards in a Week 6 loss to the 49ers prior to Washington's Week 7 bye, but he hasn't exceeded 233 passing yards in any of his 11 other regular-season outings since the start of the 2025 campaign. Sunday night's win over Philadelphia marked Daniels' first win since Week 5 of the 2025 season, when Washington defeated the Chargers. The Commanders will take a 2-4-1 record into a Week 9 home game against the Rams.","shortComment":"Daniels completed 16 of 29 passes for 217 yards and a touchdown while rushing twice for 23 yards in Sunday's 27-10 win over the Eagles.","status":"Active","date":"2026-11-02T04:49Z","athlete":{"firstName":"Jayden","lastName":"Daniels","displayName":"Jayden Daniels","shortName":"J. Daniels","links":[{"language":"en-US","rel":["playercard","desktop","athlete"],"href":"https://www.espn.com/nfl/player/_/id/4426348/jayden-daniels","text":"Player Card","shortText":"Player Card","isExternal":false,"isPremium":false},{"language":"en-US","rel":["stats","desktop","athlete"],"href":"https://www.espn.com/nfl/player/stats/_/id/4426348/jayden-daniels","text":"Stats","shortText":"Stats","isExternal":false,"isPremium":false},{"language":"en-US","rel":["stats","sportscenter","app","athlete"],"href":"sportscenter://x-callback-url/showClubhouse?uid=s:20~l:28~a:4426348&section=stats","text":"Stats","shortText":"Stats","isExternal":false,"isPremium":false},{"language":"en-US","rel":["splits","desktop","athlete"],"href":"https://www.espn.com/nfl/player/splits/_/id/4426348/jayden-daniels","text":"Splits","shortText":"Splits","isExternal":false,"isPremium":false},{"language":"en-US","rel":["gamelog","desktop","athlete"],"href":"https://www.espn.com/nfl/player/gamelog/_/id/4426348/jayden-daniels","text":"Game Log","shortText":"Game Log","isExternal":false,"isPremium":false},{"language":"en-US","rel":["gamelog","sportscenter","app","athlete"],"href":"sportscenter://x-callback-url/showClubhouse?uid=s:20~l:28~a:4426348&section=gamelog","text":"Game Log","shortText":"Game Log","isExternal":false,"isPremium":false},{"language":"en-US","rel":["news","desktop","athlete"],"href":"https://www.espn.com/nfl/player/news/_/id/4426348/jayden-daniels","text":"News","shortText":"News","isExternal":false,"isPremium":false},{"language":"en-US","rel":["news","sportscenter","app","athlete"],"href":"sportscenter://x-callb