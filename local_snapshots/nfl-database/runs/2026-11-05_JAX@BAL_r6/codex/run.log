mium":false},{"language":"en-US","rel":["draftpicks","desktop","team"],"href":"https://www.espn.com/nfl/draft/teams/_/name/ten/tennessee-titans","text":"Draft Picks","shortText":"Draft Picks","isExternal":false,"isPremium":true},{"language":"en-US","rel":["transactions","desktop","team"],"href":"https://www.espn.com/nfl/team/transactions/_/name/ten","text":"Transactions","shortText":"Transactions","isExternal":false,"isPremium":false},{"language":"en-US","rel":["injuries","desktop","team"],"href":"https://www.espn.com/nfl/team/injuries/_/name/ten","text":"Injuries","shortText":"Injuries","isExternal":false,"isPremium":false},{"language":"en-US","rel":["depthchart","desktop","team"],"href":"https://www.espn.com/nfl/team/depth/_/name/ten","text":"Depth Chart","shortText":"Depth Chart","isExternal":false,"isPremium":false},{"language":"en-US","rel":["depthchart","sportscenter","app","team"],"href":"sportscenter://x-callback-url/showClubhouse?uid=s:20~l:28~t:10&section=depthchart","text":"Depth Chart","shortText":"Depth Chart","isExternal":false,"isPremium":false}]},"notes":{"items":[{"id":"645526","type":"news","date":"2026-11-02T03:29Z","headline":"Helm caught five of nine targets for 76 yards during Sunday's 43-36 overtime loss to the Bengals.","text":"Helm led the team in targets while he was able to register a new career-high 76 receiving yards in the contest. The tight end has now reeled in eight passes over the last two weeks after he caught nine of 13 targets for 60 yards over the first six games of the 2026 campaign. Helm will have a tough test against the Jaguars in Week 10 after the team's bye week in Week 9.","source":"RotoWire"}]},"status":{"id":"1","name":"Active","type":"active","abbreviation":"Active"}},"source":{"id":"1","description":"basic/manual","state":"basic"},"type":{"id":"0","name":"INJURY_STATUS_ACTIVE","description":"active","abbreviation":"A"}},{"id":"645504","longComment":"Robinson didn't experience a significant change in role in the absence of Carnell Tate (shoulder), as this was the fourth consecutive game in which Robinson notched either six or seven targets. His 57 receiving yards tied a season high, and Robinson scored his third touchdown of the season on a 15-yard catch in the fourth quarter. The Titans took a seven-point lead with 3:46 remaining after a successful two-point conversion following Robinson's TD, but the Bengals answered with a game-tying touchdown drive and eventually won in OT to drop the Titans to 1-7. Robinson and the Titans will be on bye in Week 9 before returning to action against the Jaguars in Week 10.","shortComment":"Robinson caught six of seven targets for 57 yards and a touchdown in Sunday's 43-36 overtime loss to the Bengals. He also lost a fumble.","status":"Active","date":"2026-11-02T02:38Z","athlete":{"firstName":"Wan'Dale","lastName":"Robinson","displayName":"Wan'Dale Robinson","shortName":"W. Robinson","links":[{"language":"en-US","rel":["playercard","desktop","athlete"],"href":"https://www.espn.com/nfl/player/_/id/4569587/wandale-robinson","text":"Player Card","shortText":"Player Card","isExternal":false,"isPremium":false},{"language":"en-US","rel":["stats","desktop","athlete"],"href":"https://www.espn.com/nfl/player/stats/_/id/4569587/wandale-robinson","text":"Stats","shortText":"Stats","isExternal":false,"isPremium":false},{"language":"en-US","rel":["stats","sportscenter","app","athlete"],"href":"sportscenter://x-callback-url/showClubhouse?uid=s:20~l:28~a:4569587&section=stats","text":"Stats","shortText":"Stats","isExternal":false,"isPremium":false},{"language":"en-US","rel":["splits","desktop","athlete"],"href":"https://www.espn.com/nfl/player/splits/_/id/4569587/wandale-robinson","text":"Splits","shortText":"Splits","isExternal":false,"isPremium":false},{"language":"en-US","rel":["gamelog","desktop","athlete"],"href":"https://www.espn.com/nfl/player/gamelog/_/id/4569587/wandale-robinson","text":"Game Log","shortText":"Game Log","isExternal":false,"isPremium"